# Copie para ".env" (desenvolvimento) e preencha. No Vercel, cadastre as mesmas variáveis em
# Project → Settings → Environment Variables. Sem elas, a Rutte funciona sem login (dados só no navegador).

# Supabase → Project Settings → API (Data API): "Project URL" e a chave "anon public"
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public

# 1 = mostra "Continuar com Google" (ative antes o provedor Google em Authentication → Providers)
VITE_SUPABASE_GOOGLE=0
